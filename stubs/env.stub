# ---------------------------------------------------------------------------
# Laravel Security Monitor (Bulwark)
# Konfigurasi Perlindungan WAF, Brute Force, dan Karantina IP
# ---------------------------------------------------------------------------

# Sakelar utama WAF: Aktifkan (true) atau nonaktifkan (false) seluruh inspeksi keamanan
SECURITY_MONITOR_ENABLED=true

# Penegakan blokir: Tolak request dari IP yang terblokir dengan respons HTTP 403
SECURITY_BLOCK_ENFORCEMENT=true

# Pemblokiran otomatis berjenjang: Blokir IP jika jumlah ancaman mencapai threshold
SECURITY_AUTO_BLOCK_ENABLED=true
# Jumlah pelanggaran ancaman sebelum IP diblokir (default: 3 kali)
SECURITY_AUTO_BLOCK_THRESHOLD=3
# Jendela waktu akumulasi evaluasi ancaman dalam satuan menit (default: 10 menit)
SECURITY_AUTO_BLOCK_WINDOW=10
# Durasi masa blokir otomatis dalam satuan jam (default: 24 jam)
SECURITY_AUTO_BLOCK_DURATION=24
# Lingkup pemblokiran otomatis: 'device' (hanya perangkat penyerang, aman untuk WiFi bersama) atau 'ip' (seluruh router)
SECURITY_AUTO_BLOCK_SCOPE=device

# Pemblokiran instan (Zero Tolerance): Langsung blokir pada percobaan pertama
# untuk serangan fatal (webshell, null byte, double extension .php.jpg, akses .env/.git)
SECURITY_INSTANT_BLOCK_ENABLED=true
# Durasi masa blokir instan dalam satuan jam (default: 720 jam = 30 hari)
SECURITY_INSTANT_BLOCK_DURATION=720
# Lingkup pemblokiran instan: 'device' (hanya perangkat penyerang, aman untuk WiFi bersama) atau 'ip' (seluruh router)
SECURITY_INSTANT_BLOCK_SCOPE=device

# Proteksi brute force login bertingkat (cooldown 1m, 5m, 15m, hingga 24 jam)
SECURITY_LOGIN_LOCKOUT_ENABLED=true
# Batas kegagalan login berturut-turut sebelum dikenakan penundaan pertama
SECURITY_LOGIN_LOCKOUT_THRESHOLD=3
# Durasi penundaan (cooldown) awal dalam satuan menit
SECURITY_LOGIN_LOCKOUT_BASE_MINUTES=1
# Batas durasi maksimal penundaan dalam satuan menit
SECURITY_LOGIN_LOCKOUT_MAX_MINUTES=30
# Waktu peluruhan riwayat kegagalan jika tidak ada percobaan baru (dalam menit)
SECURITY_LOGIN_LOCKOUT_DECAY_MINUTES=60

# Masa retensi berkas log audit keamanan dalam satuan hari (dibersihkan via security:prune-logs)
SECURITY_LOG_RETENTION_DAYS=90

# Daftar putih IP yang tidak akan pernah diblokir (pisahkan dengan koma jika lebih dari satu)
SECURITY_IP_WHITELIST=127.0.0.1,::1

# Rute REST API headless (/api/security/*): Set false jika aplikasi hanya menggunakan rute web biasa
SECURITY_ROUTES_ENABLED=true

# Dashboard monitoring Starter Kit (fitur visual di prefix /security, wajib login pengguna)
# Publikasikan tampilannya dengan:
#   php artisan security:install --with-blade (atau --tag=starterkit-blade)
#   php artisan security:install --with-tsx   (atau --tag=starterkit-tsx)
#   php artisan security:install --with-both  (keduanya)
SECURITY_DASHBOARD_ENABLED=false
# Stack tampilan dashboard: "livewire" / "blade" atau "react" / "tsx"
SECURITY_DASHBOARD_DRIVER=livewire
# Awalan URL dashboard monitoring (default: security) -> diakses pada /security
SECURITY_DASHBOARD_PREFIX=security
# Batasi akses dashboard hanya untuk akun ber-role admin (default: false, cukup login)
SECURITY_DASHBOARD_ADMIN_ONLY=false

